---
interface Props { hero: { eyebrow: string; headline: string; lead: string } }
const { hero } = Astro.props;
---
<section class="page-hero">
  <div class="container">
    {hero.eyebrow && <span class="eyebrow">{hero.eyebrow}</span>}
    <h1>{hero.headline}</h1>
    <p class="lead">{hero.lead}</p>
  </div>
</section>
