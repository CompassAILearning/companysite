---
interface Props {
  cta: { heading: string; text: string; buttonLabel: string; buttonUrl: string };
  alt?: boolean;
}
const { cta, alt = false } = Astro.props;
---
<section class:list={['section', 'cta-band', { 'section-alt': alt }]}>
  <div class="container">
    <div class="cta-card">
      <h2>{cta.heading}</h2>
      <p>{cta.text}</p>
      <a href={cta.buttonUrl} class="btn btn-accent">{cta.buttonLabel}</a>
    </div>
  </div>
</section>
