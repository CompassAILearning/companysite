---
// Line icons used on the site. Editors pick one by name in the CMS.
interface Props { name: string; class?: string }
const { name, class: cls = 'step-icon' } = Astro.props;
---
<svg class={cls} viewBox="0 0 48 48" aria-hidden="true">
  {name === 'upload' && (
    <>
      <path d="M28 5H12a3 3 0 0 0-3 3v32a3 3 0 0 0 3 3h12M28 5l10 10M28 5v10h10M38 15v12"/>
      <path d="M15 22h8M15 28h5"/>
      <path d="M34 44V31M29 36l5-5 5 5M27 44h14"/>
    </>
  )}
  {name === 'questions' && (
    <>
      <path d="M24 38H8a3 3 0 0 1-3-3V11a3 3 0 0 1 3-3h28a3 3 0 0 1 3 3v9"/>
      <path d="M5 17h34M13 4v8M31 4v8"/>
      <path d="M11 24h4M19 24h4M11 30h4"/>
      <path d="M28 25h15a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2h-8l-5 4v-4h-2a2 2 0 0 1-2-2V27a2 2 0 0 1 2-2z"/>
      <path d="M33.5 30a2.5 2.5 0 1 1 3.5 2.3c-.6.3-1 .9-1 1.5v.4M36 37.2v.1"/>
    </>
  )}
  {name === 'plan' && (
    <>
      <path d="M30 43H11a3 3 0 0 1-3-3V11a3 3 0 0 1 3-3h4M33 8h4a3 3 0 0 1 3 3v15"/>
      <rect x="15" y="4" width="18" height="8" rx="2"/>
      <path d="M14 20l2 2 4-4M24 20h9M14 29l2 2 4-4M24 29h5M14 37h6"/>
      <path d="M38 30l1.8 4.2L44 36l-4.2 1.8L38 42l-1.8-4.2L32 36l4.2-1.8z"/>
    </>
  )}
  {name === 'phone' && (
    <>
      <rect x="13" y="4" width="22" height="40" rx="4"/>
      <path d="M21 9h6M22 39h4"/>
    </>
  )}
  {name === 'android' && (
    <>
      <rect x="13" y="4" width="22" height="40" rx="4"/>
      <path d="M13 36h22M22 40h4"/>
    </>
  )}
  {name === 'web' && (
    <>
      <rect x="5" y="8" width="38" height="26" rx="3"/>
      <path d="M17 42h14M24 34v8M5 15h38"/>
    </>
  )}
</svg>
