---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import home from '../content/home.json';
const { hero, features, steps, signup } = home;
---
<Base title={home.seo.title} description={home.seo.description} current="home">
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <h1>{hero.headline}</h1>
        <p class="lead">{hero.lead}</p>
        <a href="#signup" class="btn btn-primary">
          {hero.ctaLabel}
          <svg class="arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6"/></svg>
        </a>
      </div>

      <div class="hero-media">
        <div class="video-card">
          <!-- Swap the image for a <video> once the product video is ready -->
          <div class="video-frame">
            <img src={hero.image} alt={hero.imageAlt} width="724" height="483">
            <button class="play-btn" type="button" aria-label="Play video">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5z"/></svg>
            </button>
            <div class="progress" aria-hidden="true"><span class="progress-knob"></span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="features" id="features">
    <div class="container">
      <div class="features-panel">
        <h2>{features.heading}</h2>
        <div class="feature-grid">
          {features.cards.map((card) => (
            <article class={`feature-card feature-${card.color}`}>
              <h3>{card.title}</h3>
              <p>{card.body}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="steps" id="how-it-works">
    <div class="container">
      <h2>{steps.heading}</h2>
      <ol class="step-list">
        {steps.items.map((step) => (
          <li class="step">
            <Icon name={step.icon} />
            <span class="step-label">{step.label}</span>
            <span class="step-text">{step.text}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="signup" id="signup">
    <div class="container">
      <div class="signup-card">
        <h2>{signup.heading}</h2>
        <div class="signup-inner">
          <div class="signup-pitch">
            <ul class="checklist">
              {signup.checklist.map((item) => <li>{item}</li>)}
            </ul>
            <p class="signup-tagline">{signup.tagline}</p>
          </div>

          <form class="signup-form" id="signup-form" novalidate>
            <div class="form-row">
              <div class="field">
                <label for="first-name">First Name*</label>
                <input id="first-name" name="firstName" type="text" placeholder="e.g. Jordon" autocomplete="given-name" required>
              </div>
              <div class="field">
                <label for="last-name">Last Name*</label>
                <input id="last-name" name="lastName" type="text" placeholder="e.g. Miller" autocomplete="family-name" required>
              </div>
            </div>
            <div class="field">
              <label for="email">Campus Email or Personal Email*</label>
              <input id="email" name="email" type="email" placeholder="e.g. Jordonm@university.org" autocomplete="email" required>
            </div>
            <div class="field">
              <label for="class-year">Academic Class Year</label>
              <select id="class-year" name="classYear">
                <option>Freshman/First Year</option>
                <option>Sophomore/Second Year</option>
                <option>Junior/Third Year</option>
                <option>Senior/Fourth Year</option>
                <option>Graduate Student</option>
                <option>Other</option>
              </select>
            </div>
            <p class="form-error" role="alert" hidden></p>
            <button type="submit" class="btn btn-accent">{signup.buttonLabel}</button>
            <p class="form-success" role="status" hidden>{signup.successMessage}</p>
          </form>
        </div>
      </div>
    </div>
  </section>
</Base>
