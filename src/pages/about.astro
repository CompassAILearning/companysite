---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import about from '../content/about.json';
const { hero, mission, values, stories, team, cta } = about;

const paragraphs = mission.body.split(/\n\s*\n/).filter(Boolean);
const initials = (name: string) =>
  name.split(/\s+/).filter(Boolean).map((w) => w[0]).join('').slice(0, 2).toUpperCase();
---
<Base title={about.seo.title} description={about.seo.description} current="about">
  <PageHero hero={hero} />

  <section class="section">
    <div class="container two-col">
      <div>
        <h2>{mission.heading}</h2>
        {paragraphs.map((p) => <p>{p}</p>)}
      </div>
      <div class="media-card">
        <img src={mission.image} alt={mission.imageAlt} width="724" height="483">
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-head">
        <h2>{values.heading}</h2>
        <p>{values.intro}</p>
      </div>
      <div class="card-grid">
        {values.cards.map((card) => (
          <article class={`feature-card feature-${card.color}`}>
            <h3>{card.title}</h3>
            <p>{card.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="stories">
    <div class="container">
      <div class="section-head">
        <h2>{stories.heading}</h2>
        <p>{stories.intro}</p>
      </div>
      <div class="card-grid quote-grid">
        {stories.quotes.map((q) => (
          <figure class="quote-card">
            <blockquote>{q.quote}</blockquote>
            <figcaption>— {q.attribution}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-head">
        <h2>{team.heading}</h2>
        <p>{team.intro}</p>
      </div>
      <div class="team-grid">
        {team.members.map((m) => (
          <div>
            {m.photo
              ? <img class="avatar" src={m.photo} alt={m.name} width="120" height="120">
              : <div class="avatar" aria-hidden="true">{initials(m.name)}</div>}
            <h3>{m.name}</h3>
            <p>{m.role}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBand cta={cta} />
</Base>
