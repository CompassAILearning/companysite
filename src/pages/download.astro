---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import page from '../content/download.json';
const { hero, platforms, requirements, sync, cta } = page;
---
<Base title={page.seo.title} description={page.seo.description} current="download">
  <PageHero hero={hero} />

  <section class="section section-alt">
    <div class="container">
      <div class="download-grid">
        {platforms.map((p) => (
          <div class="platform-card">
            <Icon name={p.icon} />
            {p.comingSoon && <span class="badge-soon">Coming soon</span>}
            <h3>{p.name}</h3>
            <p>{p.description}</p>
            {p.url && !p.comingSoon
              ? <a href={p.url} class={`btn btn-${p.style}`}>{p.buttonLabel}</a>
              : <span class={`btn btn-${p.style} btn-disabled`} aria-disabled="true">{p.buttonLabel}</span>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>{requirements.heading}</h2>
        {requirements.intro && <p>{requirements.intro}</p>}
      </div>
      <div class="table-wrap">
        <table class="spec-table">
          <thead>
            <tr><th scope="col">Platform</th><th scope="col">Minimum version</th><th scope="col">Notes</th></tr>
          </thead>
          <tbody>
            {requirements.rows.map((r) => (
              <tr><th scope="row">{r.platform}</th><td>{r.minimum}</td><td>{r.notes}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container two-col">
      <div>
        <h2>{sync.heading}</h2>
        <ul class="checklist checklist-dark">
          {sync.items.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div class="media-card">
        <img src={sync.image} alt={sync.imageAlt} width="724" height="483">
      </div>
    </div>
  </section>

  <CtaBand cta={cta} alt />
</Base>
